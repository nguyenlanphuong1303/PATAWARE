{
  "manifest_version": 3,
  "name": "PATAWARE - Chống Lừa Đảo Trực Tuyến",
  "version": "1.0.0",
  "description": "Lá chắn an ninh mạng thông minh: Tự động phát hiện và chặn đứng trang web giả mạo ngân hàng, lừa đảo, đánh cắp thông tin.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PATAWARE Shield - Trạng thái bảo vệ",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
