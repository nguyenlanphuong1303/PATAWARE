# Server settings
APP_NAME="Pataware Anti-Scam Platform"
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security & JWT
SECRET_KEY=pataware-super-secret-key-change-in-production-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# 1. PostgreSQL (Recommended for Production):
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/pataware_db
# 2. MySQL (Alternative for Production):
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/pataware_db?charset=utf8mb4
# 3. SQLite (Default for quick local development only - NOT recommended for production):
DATABASE_URL=sqlite:///./pataware.db

# Database Connection Pool (Production tuning)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30

# AI & Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Tesseract OCR Path (leave blank if in PATH)
# Example Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Threat Intelligence Feeds (Optional: Tăng cường độ chính xác nhận diện mã độc toàn cầu)
# 1. Google Safe Browsing API v4: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=
# 2. VirusTotal API v3 (Aggregates 70+ Antivirus engines): https://www.virustotal.com/
VIRUSTOTAL_API_KEY=
# 3. URLhaus (Abuse.ch - Free global malware database): Mặc định kích hoạt True không cần key
ENABLE_URLHAUS_CHECK=True
# 4. Chống Lừa Đảo (ChongLuaDao.vn - Cổng an ninh mạng Việt Nam): Mặc định kích hoạt True
ENABLE_CHONGLUADAO_CHECK=True
