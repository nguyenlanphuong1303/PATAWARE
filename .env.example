# Server settings
APP_NAME="Pataware Anti-Scam Platform"
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security & JWT
SECRET_KEY=pataware-super-secret-key-change-in-production-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL or SQLite fallback)
# MySQL format: mysql+pymysql://username:password@localhost:3306/pataware_db?charset=utf8mb4
# SQLite format (default for quick dev): sqlite:///./pataware.db
DATABASE_URL=sqlite:///./pataware.db

# AI & Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Tesseract OCR Path (leave blank if in PATH)
# Example Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
